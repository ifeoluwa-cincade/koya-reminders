{
 "_about": "A lead's company: one chain everywhere. Same file in koya-app test/fixtures/lead_company.json and koya-reminders crm/dashboard/lead_company_fixtures.json. Made-up names only.",
 "cases": [
  {"name": "1 the person's linked company wins over everything else",
   "in": {"person": {"company": {"name": "Acme Labs", "domain": "acmelabs.example"}, "email": "jo@other.example"},
          "deals": [{"name": "Jo Bloggs / Something Else", "ext": "pv-1", "company": {"name": "Deal Co", "domain": null}}],
          "domain_company": {"name": "Other Inc", "domain": "other.example"}, "plusvibe": {"company_name": "PV Co"}, "cloudtalk": {"company": "CT Co"}},
   "out": {"company": "Acme Labs", "from": "person", "website": "https://acmelabs.example"}},
  {"name": "2 no person link: the deal's associated company",
   "in": {"person": {"company": null, "email": "jo@gmail.com"}, "deals": [{"name": "Jo Bloggs / Name Half", "ext": "pv-2", "company": {"name": "Deal Co", "domain": "dealco.example"}}],
          "plusvibe": {"company_name": "PV Co"}},
   "out": {"company": "Deal Co", "from": "deal", "website": "https://dealco.example"}},
  {"name": "3 no links: the Attio company with the person's work email domain",
   "in": {"person": {"company": null, "email": "jo@widgetworks.example"}, "deals": [{"name": "Jo Bloggs / Name Half", "ext": "pv-3", "company": null}],
          "domain_company": {"name": "Widget Works", "domain": "widgetworks.example"}, "plusvibe": {"company_name": "PV Co"}},
   "out": {"company": "Widget Works", "from": "domain", "website": "https://widgetworks.example"}},
  {"name": "4 a free mail domain never matches a company",
   "in": {"person": {"company": null, "email": "jo@gmail.com"}, "deals": [], "domain_company": {"name": "Google", "domain": "gmail.com"}},
   "out": {"company": "", "from": null, "website": null}},
  {"name": "5 cold-email replier with a gmail address: PlusVibe's company_name",
   "in": {"person": {"company": null, "email": "jo.bloggs@gmail.com"}, "deals": [{"name": "Jo Bloggs / Bloggs Studio", "ext": "pv-5", "company": null}],
          "plusvibe": {"company_name": "Bloggs Studio Ltd", "company_website": "https://bloggs.example"}},
   "out": {"company": "Bloggs Studio Ltd", "from": "plusvibe", "website": "https://bloggs.example"}},
  {"name": "6 a call lead with no email anywhere: the CloudTalk contact's company",
   "in": {"person": {"company": null, "email": null, "phone": "+447700900123"}, "deals": [], "plusvibe": null, "cloudtalk": {"company": "Callco"}},
   "out": {"company": "Callco", "from": "cloudtalk", "website": null}},
  {"name": "7 last resort: the company half of a '<lead> / <company>' deal name",
   "in": {"person": {"company": null, "email": "jo@gmail.com"}, "deals": [{"name": "Jo Bloggs / Bloggs Works", "ext": "pv-7", "company": null}], "plusvibe": {"company_name": ""}, "cloudtalk": null},
   "out": {"company": "Bloggs Works", "from": "deal_name", "website": null}},
  {"name": "8 a deal the page created by hand (no external id) also gives its company half",
   "in": {"person": {"company": null, "email": null}, "deals": [{"name": "Jo Bloggs / Hand Made Co", "ext": null, "company": null}]},
   "out": {"company": "Hand Made Co", "from": "deal_name", "website": null}},
  {"name": "9 placement deal with the client's company linked: the client company, never the developer",
   "in": {"person": {"company": {"name": "Client Corp AI", "domain": "clientcorp.example"}, "email": "boss@clientcorp.example"},
          "deals": [{"name": "Pat Client / Dev Placed", "ext": "aat-0123456789abcdef", "stage": "Won", "company": null}, {"name": "Pat Client / Second Dev", "ext": "aat-fedcba9876543210", "stage": "Trial", "company": null}]},
   "out": {"company": "Client Corp AI", "from": "person", "website": "https://clientcorp.example"}},
  {"name": "10 placement deal and nothing else known: empty, never the developer's name",
   "in": {"person": {"company": null, "email": null}, "deals": [{"name": "Pat Client / Dev Placed", "ext": "aat-0123456789abcdef", "stage": "Lost", "company": null}]},
   "out": {"company": "", "from": null, "website": null}},
  {"name": "11 placement client found in PlusVibe: that company",
   "in": {"person": {"company": null, "email": "pat@gmail.com"}, "deals": [{"name": "Pat Client / Dev Placed", "ext": "aat-0123456789abcdef", "company": null}], "plusvibe": {"company_name": "Client Corp AI"}},
   "out": {"company": "Client Corp AI", "from": "plusvibe", "website": null}},
  {"name": "12 placement deal next to a normal deal: only the normal deal's name is used",
   "in": {"person": {"company": null, "email": null}, "deals": [{"name": "Pat Client / Dev Placed", "ext": "aat-0123456789abcdef", "company": null}, {"name": "Pat Client / Real Co", "ext": "pv-12", "company": null}]},
   "out": {"company": "Real Co", "from": "deal_name", "website": null}},
  {"name": "13 a deal named only after the person gives nothing",
   "in": {"person": {"company": null, "email": "jo@gmail.com"}, "deals": [{"name": "Jo Bloggs", "ext": null, "company": null}]},
   "out": {"company": "", "from": null, "website": null}},
  {"name": "14 blank and placeholder values are skipped, not shown",
   "in": {"person": {"company": {"name": "   ", "domain": null}, "email": "jo@gmail.com"}, "deals": [{"name": "Jo Bloggs / ", "ext": "pv-14", "company": {"name": "", "domain": null}}],
          "plusvibe": {"company_name": "N/A"}, "cloudtalk": {"company": " Real  Name  Co "}},
   "out": {"company": "Real Name Co", "from": "cloudtalk", "website": null}},
  {"name": "15 a work email whose domain is not an Attio company falls through to PlusVibe",
   "in": {"person": {"company": null, "email": "jo@unknown.example"}, "deals": [], "domain_company": null, "plusvibe": {"company_name": "Unknown Ltd", "company_website": "unknown.example"}},
   "out": {"company": "Unknown Ltd", "from": "plusvibe", "website": "https://unknown.example"}}
 ]
}
